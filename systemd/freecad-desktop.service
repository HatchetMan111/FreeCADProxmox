[Unit]
Description=FreeCAD Desktop via KasmVNC (:6080, Login-frei im LAN)
After=network-online.target freecad.service
Wants=network-online.target

[Service]
Type=simple
User=root
Environment=DISPLAY=:99
ExecStartPre=-/bin/sh -c 'rm -f /tmp/.X99-lock'
# -disableBasicAuth: volle Lese-/Schreibrechte ohne Web-Login (nur für vertrauenswürdiges LAN!).
# printf '2...': beantwortet den First-Run-Wizard (Write-User-Auswahl) non-interaktiv,
# falls noch kein KasmVNC-User existiert (Payload legt zusätzlich einen per vncpasswd an).
ExecStart=/bin/sh -c "printf '2\n2\n2\n' | kasmvncserver :99 -geometry 1600x900 -websocketPort 6080 -disableBasicAuth -SecurityTypes None -- /usr/bin/startxfce4"
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
